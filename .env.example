# FarmLab API - Environment Configuration

# Server
PORT=5000
NODE_ENV=production

# MongoDB Atlas
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/farmlab?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRY=24h

# CORS - Frontend URL (Vercel URL after deployment)
CORS_ORIGIN=https://your-app.vercel.app
